            {
              "task": "db-query",
              "weight": 1,
              "params": {
                "n": 5
              }
            }
          ]
        },
        {
          "phase": "attack",
          "process": "poisson",
          "rps": 8,
          "task_mix": [
            {
              "task": "db-query",
              "weight": 1,
              "params": {
                "n": 5
              }
            }
          ]
        },
        {
          "phase": "cooldown",
          "process": "poisson",
          "rps": 8,
          "task_mix": [
            {
              "task": "db-query",
              "weight": 1,
              "params": {
                "n": 5
              }
            }
          ]
