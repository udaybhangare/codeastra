{
  "id": "S3",
  "name": "db-connection-hog",
  "description": "rogue-ml holds DB connections with slow queries; data-co p99 <= 2x",
  "default_seed": 42,
  "phases": [
    {
      "name": "warmup",
      "duration_s": 20
    },
    {
      "name": "attack",
      "duration_s": 60
    },
    {
      "name": "cooldown",
      "duration_s": 30
    }
  ],
  "tenants": [
    {
      "tenant": "acme-shop",
      "role": "victim",
      "arrivals": [
        {
          "phase": "warmup",
          "process": "poisson",
          "rps": 30,
          "task_mix": [
            {
              "task": "echo",
              "weight": 0.85
            },
            {
              "task": "db-query",
              "weight": 0.15,
              "params": {
                "n": 1
              }
            }
          ]
        },
        {
          "phase": "attack",
          "process": "poisson",
          "rps": 30,
          "task_mix": [
            {
              "task": "echo",
              "weight": 0.85
            },
            {
              "task": "db-query",
              "weight": 0.15,
              "params": {
                "n": 1
              }
            }
          ]
        },
        {
          "phase": "cooldown",
          "process": "poisson",
          "rps": 30,
          "task_mix": [
            {
              "task": "echo",
              "weight": 0.85
            },
            {
              "task": "db-query",
              "weight": 0.15,
              "params": {
                "n": 1
              }
            }
          ]
        }
      ]
    },
