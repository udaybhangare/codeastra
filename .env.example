# Copy to .env (never commit .env). Dev defaults only.
POSTGRES_USER=bulkhead
POSTGRES_PASSWORD=bulkhead
POSTGRES_DB=bulkhead
POSTGRES_PORT=5432
REDIS_PORT=6379

DATABASE_URL=postgres://bulkhead:bulkhead@localhost:5432/bulkhead?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# platform
HTTP_ADDR=:8080
ISOLATION=on
JWT_SECRET=change-me-in-.env
ADMIN_API_KEY=change-me-in-.env
ADMIN_JWT_SECRET=change-me-too-in-.env  # must differ from JWT_SECRET
PREDICTOR_URL=http://localhost:8000

# mock stream (dashboard dev): ws://localhost:8081/admin/stream
MOCKSTREAM_ADDR=:8081
