# Tenant worker (static binary on scratch). Context: worker/. Tag: bulkhead/worker:dev
# (the tag bulkheadd's workerpool uses by default).
ARG GO_VERSION=1.27
FROM golang:${GO_VERSION} AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /worker .

FROM scratch
COPY --from=build /worker /worker
USER 65532:65532
EXPOSE 8080
HEALTHCHECK --interval=2s --timeout=2s --start-period=1s --retries=3 CMD ["/worker", "-healthcheck"]
ENTRYPOINT ["/worker"]
