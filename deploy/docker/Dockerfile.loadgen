# Load generator CLI (scenarios are embedded). Context: loadgen/
ARG GO_VERSION=1.27
FROM golang:${GO_VERSION} AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /loadgen .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /loadgen /loadgen
ENTRYPOINT ["/loadgen"]
