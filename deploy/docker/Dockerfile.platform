# Multi-stage: bulkheadd + migrate + seed in one small image. Context: platform/
ARG GO_VERSION=1.27
FROM golang:${GO_VERSION} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ENV CGO_ENABLED=0 GOOS=linux
RUN go build -trimpath -ldflags='-s -w' -o /out/bulkheadd ./cmd/bulkheadd \
 && go build -trimpath -ldflags='-s -w' -o /out/migrate ./cmd/migrate \
 && go build -trimpath -ldflags='-s -w' -o /out/seed ./cmd/seed

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/ /
EXPOSE 8080
ENTRYPOINT ["/bulkheadd"]
