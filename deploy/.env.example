# Copy to deploy/.env (never commit it). `deploy/gen-env.sh` does this and fills secrets.
SITE_ADDRESS=bulkhead.udaybhangare.com   # or the Elastic IP, or "localhost" for demo-local
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-16+chars
ADMIN_JWT_SECRET=change-me-too-16+chars  # must differ from JWT_SECRET
ADMIN_API_KEY=change-me-16+chars
ISOLATION=on
PREDICTOR_CAPACITY_COST_UNITS_S=200      # a guess; calibrate (prompt 19)
BULKHEAD_BIND_IP=127.0.0.1               # box #1 PRIVATE IP so loadgen on box #2 can reach :8080
# demo-local only (avoid clashing with local web servers):
# CADDY_HTTP_PORT=8088
# CADDY_HTTPS_PORT=8443
# box #2 only:
# LOADGEN_TARGET=http://10.0.1.10:8080
